# =========================================================================
# GLOBAL ENVIRONMENT SETTINGS
# =========================================================================
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
COMPOSE_PROJECT_NAME=warranty-management-base
WARRANTY_CERTIFICATE_CLEANUP_ENABLED=false
WARRANTY_CERTIFICATE_CLEANUP_DRY_RUN=true
WARRANTY_CERTIFICATE_CLEANUP_CRON="0 3 * * 0"
WARRANTY_CERTIFICATE_ORPHAN_RETENTION_DAYS=30
STORAGE_USAGE_MONITOR_ENABLED=false
STORAGE_USAGE_MONITOR_CRON="0 4 * * *"
# Set this to your MinIO storage budget to enable 70/85/95% alerts.
# STORAGE_CAPACITY_BYTES=107374182400


# =========================================================================
# BACKEND (API) CONFIGURATION
# =========================================================================
APP_NAME="Warranty Management API"
APP_VERSION="1.0.0"
API_PORT=4100
PORT=${API_PORT}
BE_PORT=${API_PORT}
BACKEND_URL="http://localhost:4100"
PUBLIC_API_URL="http://localhost:4100/api/v1"

# Security & Auth
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# Database seed credentials
# Store real values only in local environment files or deployment secrets.
SEED_DEMO_USER_PASSWORD=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Storage & Uploads
STORAGE_DRIVER=local
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760
STORAGE_ROOT_DIR=./storage
STORAGE_PUBLIC_DIR_NAME=public
STORAGE_PRIVATE_DIR_NAME=private
STORAGE_TEMP_DIR_NAME=temp
MINIO_ENDPOINT=localhost
MINIO_PORT=19000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_PUBLIC=warranty-management-base-public
MINIO_BUCKET_PRIVATE=warranty-management-base-private
MINIO_BUCKET_TEMP=warranty-management-base-temp
MINIO_TEMP_RETENTION_DAYS=7
MINIO_CONSOLE_PORT=19001
ASSET_CDN_URL="http://localhost:4100/cdn"
ASSET_MAX_FILE_SIZE=10485760
ASSET_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml,video/mp4,video/quicktime,audio/mpeg,audio/wav,application/pdf

# =========================================================================
# FRONTEND (MAIN STOREFRONT) CONFIGURATION
# =========================================================================
WEB_PORT=4101
FE_PORT=${WEB_PORT}
FRONTEND_URL="http://localhost:4101"
NEXT_ASSET_API_URL="http://localhost:4100/uploads/public/"
NEXT_PUBLIC_API_URL="http://localhost:4100/api/v1"

# =========================================================================
# FRONTEND (ADMIN PANEL) CONFIGURATION
# =========================================================================
ADMIN_PORT=4102
ADMIN_URL="http://localhost:4102"
NEXT_ASSET_API_URL="http://localhost:4100/uploads/public/"
NEXT_PUBLIC_API_URL="http://localhost:4100/api/v1"

# =========================================================================
# DATABASE (POSTGRESQL) CONFIGURATION
# =========================================================================
DB_HOST=localhost
DB_PORT=15432
DB_USER=warranty_management_base_user
DB_PASSWORD=warranty_management_base_password
DB_NAME=warranty_management_base
DB_SCHEMA=public

# Standardized DATABASE_URL
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=${DB_SCHEMA}

# Docker Database Config (Keep in sync with variables above)
POSTGRES_USER=warranty_management_base_user
POSTGRES_PASSWORD=warranty_management_base_password
POSTGRES_DB=warranty_management_base
DEV_DB_PORT=15432
PROD_DB_PORT=25432

# =========================================================================
# CACHE (REDIS) CONFIGURATION
# =========================================================================
REDIS_HOST=localhost
REDIS_DEV_PORT=16379
REDIS_PASSWORD=warranty_management_base_redis_password
REDIS_DB_PORT=16379

# Standardized REDIS_URL
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_DEV_PORT}

# =========================================================================
# EMAIL (SMTP) CONFIGURATION
# =========================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="${APP_NAME} Agent <no-reply@example.com>"
EMAIL_FROM="${APP_NAME} <${SMTP_USER}>"
EMAIL_TEMPLATES_PATH=src/module/email/templates

# =========================================================================
# THIRD-PARTY SERVICES & OAUTH
# =========================================================================

# Google OAuth
GOOGLE_CLIENT_ID="GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:4100/api/v1/auth/google/callback"

# Vietnam Provinces Open API v2
VIETNAM_PROVINCES_ENABLED=true
VIETNAM_PROVINCES_API_BASE_URL="https://provinces.open-api.vn/api/v2"
VIETNAM_PROVINCES_API_TIMEOUT_MS=5000
VIETNAM_PROVINCES_CACHE_TTL_SECONDS=86400

# Geoapify forward geocoding (free key: https://myprojects.geoapify.com)
GEOAPIFY_API_KEY=
GEOAPIFY_API_BASE_URL="https://api.geoapify.com/v1"
GEOAPIFY_TIMEOUT_MS=5000
GEOAPIFY_CACHE_TTL_SECONDS=2592000
GEOAPIFY_MAX_RESULTS=5

# =========================================================================
# MONITORING & LOGGING
# =========================================================================
LOG_LEVEL=info
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=5
PROMETHEUS_ENABLED=false
METRICS_PORT=19090
HEALTH_ENDPOINTS_ENABLED=false

# =========================================================================
# TELEGRAM NOTIFICATIONS - CI/CD
# =========================================================================
CI_TELEGRAM_BOT_TOKEN=
CI_TELEGRAM_CHAT_ID=

# =========================================================================
# CONTAINER IMAGES - CD
# =========================================================================
API_IMAGE=ghcr.io/owner/repository-api
WEB_IMAGE=ghcr.io/owner/repository-web
ADMIN_IMAGE=ghcr.io/owner/repository-admin
IMAGE_TAG=latest

# =========================================================================
# PRODUCTION BACKUPS
# =========================================================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_TELEGRAM_ENABLED=true

# =========================================================================
# GRAFANA CONFIGURATION
# =========================================================================
GRAFANA_PORT=4103
GRAFANA_ADMIN_USER=warranty_management_admin
GRAFANA_ADMIN_PASSWORD=warranty_management_grafana_change_me
GRAFANA_LOG_LEVEL=info

# =========================================================================
# NETWORK & CORS
# =========================================================================
CORS_ORIGINS="http://localhost:4100,http://localhost:4101,http://localhost:4102"
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# =========================================================================
# COOKIE
# =========================================================================
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_PARTITIONED=false
COOKIE_MAX_AGE=604800000
COOKIE_PATH=/
