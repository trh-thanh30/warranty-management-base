{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "**/*.hbs",
      "**/*.mjml.hbs",
      "**/*.html",
      "**/*.css",
      "**/*.png",
      "**/*.jpg",
      "**/*.pdf",
      "**/*.ttf"
    ]
  },
  "projects": {
    "api": {
      "type": "application",
      "root": ".",
      "entryFile": "main",
      "sourceRoot": "src"
    },
    "worker:email": {
      "type": "application",
      "root": ".",
      "entryFile": "workers/email/worker.main",
      "sourceRoot": "src"
    },
    "worker:activation-labels": {
      "type": "application",
      "root": ".",
      "entryFile": "workers/activation-label-print/worker.main",
      "sourceRoot": "src"
    }
  }
}
