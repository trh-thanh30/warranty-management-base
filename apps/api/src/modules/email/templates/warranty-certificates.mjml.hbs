<mjml>
  <mj-head>
    <mj-title>{{subject}}</mj-title>
    <mj-preview>{{preview}}</mj-preview>
    <mj-attributes>
      <mj-all font-family='Arial, Helvetica, sans-serif' />
      <mj-text color='#334155' font-size='15px' line-height='1.6' />
      <mj-section padding='0' />
    </mj-attributes>
  </mj-head>
  <mj-body background-color='#f8fafc' width='640px'>
    <mj-section background-color='#ffffff' padding='28px 28px 12px'>
      <mj-column>
        <mj-text
          color='#0f172a'
          font-size='22px'
          font-weight='800'
          padding='0'
        >{{labels.heading}}</mj-text>
        <mj-text
          color='#64748b'
          font-size='13px'
          padding='8px 0 0'
        >{{summary}}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color='#2563eb' padding='4px 0'>
      <mj-column><mj-spacer height='1px' /></mj-column>
    </mj-section>
    <mj-section background-color='#ffffff' padding='28px'>
      <mj-column>
        <mj-text padding='0 0 14px'>Xin chào {{customerName}},</mj-text>
        <mj-text padding='0 0 18px'>{{labels.description}}</mj-text>
        {{#each certificates}}
          <mj-table padding='0 0 14px'>
            <tr>
              <td
                style='padding:8px 10px;border:1px solid #e2e8f0;background:#f8fafc;color:#64748b;width:34%;'
              >{{labels.product}}</td>
              <td
                style='padding:8px 10px;border:1px solid #e2e8f0;color:#0f172a;font-weight:700;'
              >{{productName}}</td>
            </tr>
            <tr>
              <td
                style='padding:8px 10px;border:1px solid #e2e8f0;background:#f8fafc;color:#64748b;'
              >{{labels.warrantyCode}}</td>
              <td
                style='padding:8px 10px;border:1px solid #e2e8f0;color:#0f172a;'
              >{{warrantyCode}}</td>
            </tr>
            <tr>
              <td
                style='padding:8px 10px;border:1px solid #e2e8f0;background:#f8fafc;color:#64748b;'
              >{{labels.certificateNumber}}</td>
              <td
                style='padding:8px 10px;border:1px solid #e2e8f0;color:#0f172a;'
              >{{certificateNumber}}</td>
            </tr>
          </mj-table>
        {{/each}}
        <mj-text
          color='#64748b'
          font-size='13px'
          padding='10px 0 0'
        >{{labels.closing}}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>