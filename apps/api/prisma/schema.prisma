generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  email         String      @unique
  password      String
  username      String      @unique
  full_name     String?
  phone         String?     @unique
  avatar_url    String?
  role          user_role   @default(CUSTOMER)
  status        user_status @default(ACTIVE)
  is_verified   Boolean     @default(false)
  refresh_token String?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  assets                                Asset[]
  created_notifications                 Notification[]                      @relation("NotificationCreatedBy")
  notification_recipients               NotificationRecipient[]
  permissions                           UserPermission[]
  customer_profile                      Customer?
  owned_products                        ProductOwnership[]
  warranty_claim_changes                WarrantyClaimStatusHistory[]        @relation("WarrantyClaimStatusChangedBy")
  warranty_claim_service_center_changes WarrantyClaimServiceCenterHistory[] @relation("WarrantyClaimServiceCenterChangedBy")
  reviewed_warranty_activation_requests WarrantyActivationRequest[]         @relation("WarrantyActivationRequestReviewedBy")
  created_warranty_activation_requests  WarrantyActivationRequest[]         @relation("WarrantyActivationRequestCreatedBy")
  activated_warranties                  Warranty[]                          @relation("WarrantyActivatedBy")
  voided_warranties                     Warranty[]                          @relation("WarrantyVoidedBy")

  @@index([role, status])
  @@index([email])
  @@map("user")
}

model Asset {
  id             String            @id @default(uuid()) @db.Uuid
  original_name  String
  filename       String
  mime_type      String
  size           Int
  path           String
  access_type    asset_access_type @default(PUBLIC)
  type           asset_type        @default(OTHER)
  folder         String?
  metadata       Json?
  is_deleted     Boolean           @default(false)
  uploaded_by_id String?           @db.Uuid
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  uploaded_by    User?          @relation(fields: [uploaded_by_id], references: [id])
  links          AssetLink[]
  product_assets ProductAsset[]

  @@index([access_type])
  @@index([type])
  @@index([uploaded_by_id])
  @@index([is_deleted])
  @@index([created_at])
  @@map("asset")
}

model AssetLink {
  id          String   @id @default(uuid()) @db.Uuid
  asset_id    String   @db.Uuid
  entity_id   String   @db.Uuid
  entity_type String
  created_at  DateTime @default(now())

  asset Asset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@unique([asset_id, entity_id, entity_type])
  @@index([entity_id, entity_type])
  @@map("asset_link")
}

model Notification {
  id              String                       @id @default(uuid()) @db.Uuid
  title           String
  content         String
  type            String
  source          notification_source          @default(SYSTEM)
  scope           notification_scope
  delivery_status notification_delivery_status @default(SENT)
  metadata        Json?
  scheduled_at    DateTime?
  sent_at         DateTime?
  created_by_id   String?                      @db.Uuid
  created_at      DateTime                     @default(now())
  updated_at      DateTime                     @updatedAt

  created_by User?                   @relation("NotificationCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  recipients NotificationRecipient[]

  @@index([type])
  @@index([source])
  @@index([scope])
  @@index([delivery_status, scheduled_at])
  @@index([created_at])
  @@map("notification")
}

model NotificationRecipient {
  id              String                   @id @default(uuid()) @db.Uuid
  notification_id String                   @db.Uuid
  user_id         String                   @db.Uuid
  status          notification_read_status @default(UNREAD)
  read_at         DateTime?
  delivered_at    DateTime                 @default(now())
  created_at      DateTime                 @default(now())

  notification Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([notification_id, user_id])
  @@index([user_id, status, created_at])
  @@index([notification_id])
  @@map("notification_recipient")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  admin_id   String?  @db.Uuid
  admin_name String
  action     String
  type       String
  created_at DateTime @default(now())

  @@index([created_at])
  @@map("activity_log")
}

model ContentPage {
  id           String              @id @default(uuid()) @db.Uuid
  slug         String              @unique
  title        String
  summary      String?
  content      String
  kind         content_page_kind   @default(POLICY)
  status       content_page_status @default(DRAFT)
  published_at DateTime?
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt

  @@index([kind])
  @@index([status])
  @@index([published_at])
  @@map("content_page")
}

model UserPermission {
  id             String         @id @default(uuid()) @db.Uuid
  user_id        String         @db.Uuid
  permission_key permission_key
  granted        Boolean        @default(true)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, permission_key])
  @@index([user_id])
  @@map("user_permission")
}

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String?  @unique @db.Uuid
  customer_code String   @unique
  full_name     String
  phone         String?  @unique
  email         String?  @unique
  address       String?
  metadata      Json?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user                         User?                       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  ownerships                   ProductOwnership[]
  claims                       WarrantyClaim[]
  warranty_activation_requests WarrantyActivationRequest[]

  @@index([customer_code])
  @@index([full_name])
  @@index([phone])
  @@index([email])
  @@map("customer")
}

model Category {
  id          String        @id @default(uuid()) @db.Uuid
  type        category_type
  code        String?
  slug        String
  name        String
  description String?
  parent_id   String?       @db.Uuid
  icon        String?
  image_url   String?
  order       Int           @default(0)
  is_active   Boolean       @default(true)
  metadata    Json?
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  parent                       Category?                   @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children                     Category[]                  @relation("CategoryHierarchy")
  products                     Product[]
  warranty_activation_requests WarrantyActivationRequest[]

  @@unique([type, slug])
  @@index([type, is_active, order])
  @@index([parent_id])
  @@map("category")
}

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  product_code     String           @unique
  warranty_code    String?          @unique
  serial_number    String?          @unique
  name             String
  category         product_category
  category_id      String?          @db.Uuid
  brand            String?
  model            String?
  manufacture_year Int?
  description      String?
  status           product_status   @default(ACTIVE)
  metadata         Json?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  deleted_at       DateTime?

  category_ref                 Category?                   @relation(fields: [category_id], references: [id], onDelete: SetNull)
  ownerships                   ProductOwnership[]
  warranty                     Warranty?
  claims                       WarrantyClaim[]
  assets                       ProductAsset[]
  warranty_activation_requests WarrantyActivationRequest[]

  @@index([category])
  @@index([category_id])
  @@index([status])
  @@index([warranty_code])
  @@index([serial_number])
  @@index([name])
  @@map("product")
}

model ProductAsset {
  id         String             @id @default(uuid()) @db.Uuid
  product_id String             @db.Uuid
  asset_id   String             @db.Uuid
  role       product_asset_role @default(GALLERY)
  sort_order Int                @default(0)
  alt_text   String?
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@unique([product_id, asset_id])
  @@index([product_id, role, sort_order])
  @@index([asset_id])
  @@map("product_asset")
}

model ProductOwnership {
  id               String    @id @default(uuid()) @db.Uuid
  product_id       String    @db.Uuid
  customer_id      String    @db.Uuid
  owner_user_id    String?   @db.Uuid
  purchase_date    DateTime?
  activated_at     DateTime?
  ended_at         DateTime?
  is_current_owner Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  owner_user User?    @relation(fields: [owner_user_id], references: [id], onDelete: SetNull)

  @@index([product_id, is_current_owner])
  @@index([customer_id, is_current_owner])
  @@index([owner_user_id, is_current_owner])
  @@map("product_ownership")
}

model Warranty {
  id                    String          @id @default(uuid()) @db.Uuid
  product_id            String          @unique @db.Uuid
  warranty_code         String?         @unique
  start_date            DateTime?
  end_date              DateTime?
  duration_months       Int
  coverage_limit_amount Decimal?        @db.Decimal(18, 2)
  max_claim_count       Int?
  max_amount_per_claim  Decimal?        @db.Decimal(18, 2)
  status                warranty_status @default(DRAFT)
  terms                 String?
  metadata              Json?
  activated_by_id       String?         @db.Uuid
  voided_at             DateTime?
  voided_by_id          String?         @db.Uuid
  void_reason           String?
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  product            Product                    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  claims             WarrantyClaim[]
  activation_request WarrantyActivationRequest?
  certificates       WarrantyCertificate[]
  activated_by       User?                      @relation("WarrantyActivatedBy", fields: [activated_by_id], references: [id], onDelete: SetNull)
  voided_by          User?                      @relation("WarrantyVoidedBy", fields: [voided_by_id], references: [id], onDelete: SetNull)

  @@index([warranty_code])
  @@index([status])
  @@index([end_date])
  @@index([activated_by_id])
  @@index([voided_by_id])
  @@index([voided_at])
  @@map("warranty")
}

model WarrantyActivationRequest {
  id                       String                             @id @default(uuid()) @db.Uuid
  request_code             String                             @unique
  status                   warranty_activation_request_status @default(PENDING)
  source                   warranty_activation_request_source @default(PUBLIC_WEB)
  warranty_code            String
  customer_name            String
  customer_phone           String
  customer_email           String?
  customer_birthdate       DateTime?
  category_id              String?                            @db.Uuid
  product_id               String?                            @db.Uuid
  dealer_id                String?                            @db.Uuid
  vehicle_plate            String?
  vehicle_model            String?
  installed_at             DateTime?
  warranty_duration_months Int?
  province_code            String
  province_name            String
  ward_code                String
  ward_name                String
  address_detail           String
  full_address             String
  product_name             String?
  serial_number            String?
  brand                    String?
  model                    String?
  manufacture_year         Int?
  note                     String?
  admin_note               String?
  rejection_reason         String?
  created_by_id            String?                            @db.Uuid
  customer_id              String?                            @db.Uuid
  reviewed_by_id           String?                            @db.Uuid
  reviewed_at              DateTime?
  activated_warranty_id    String?                            @unique @db.Uuid
  metadata                 Json?
  created_at               DateTime                           @default(now())
  updated_at               DateTime                           @updatedAt

  created_by         User?     @relation("WarrantyActivationRequestCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  customer           Customer? @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  category           Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  product            Product?  @relation(fields: [product_id], references: [id], onDelete: SetNull)
  dealer             Dealer?   @relation(fields: [dealer_id], references: [id], onDelete: SetNull)
  reviewed_by        User?     @relation("WarrantyActivationRequestReviewedBy", fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  activated_warranty Warranty? @relation(fields: [activated_warranty_id], references: [id], onDelete: SetNull)

  @@index([request_code])
  @@index([status])
  @@index([source])
  @@index([warranty_code])
  @@index([customer_phone])
  @@index([customer_email])
  @@index([category_id])
  @@index([product_id])
  @@index([dealer_id])
  @@index([vehicle_plate])
  @@index([created_by_id])
  @@index([customer_id])
  @@index([created_at])
  @@index([warranty_code, customer_phone, status], map: "warranty_activation_request_lookup_pending")
  @@map("warranty_activation_request")
}

model WarrantyCertificate {
  id                 String                            @id @default(uuid()) @db.Uuid
  warranty_id        String                            @db.Uuid
  certificate_number String                            @unique
  version            Int                               @default(1)
  status             warranty_certificate_status       @default(PENDING)
  storage_key        String?
  recipient_email    String?
  generated_at       DateTime?
  emailed_at         DateTime?
  email_status       warranty_certificate_email_status @default(PENDING)
  last_error         String?
  metadata           Json?
  created_at         DateTime                          @default(now())
  updated_at         DateTime                          @updatedAt

  warranty Warranty @relation(fields: [warranty_id], references: [id], onDelete: Cascade)

  @@index([warranty_id])
  @@index([certificate_number])
  @@index([status])
  @@index([email_status])
  @@index([recipient_email])
  @@map("warranty_certificate")
}

model Dealer {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  phone      String?  @unique
  address    String
  province   String
  sales_name String?
  is_active  Boolean  @default(true)
  metadata   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  warranty_activation_requests WarrantyActivationRequest[]

  @@index([is_active])
  @@index([province])
  @@index([name])
  @@map("dealer")
}

model WarrantyClaim {
  id                String                  @id @default(uuid()) @db.Uuid
  claim_code        String                  @unique
  warranty_id       String                  @db.Uuid
  product_id        String                  @db.Uuid
  customer_id       String?                 @db.Uuid
  service_center_id String?                 @db.Uuid
  warranty_code     String
  requester_name    String?
  requester_phone   String?
  issue_title       String
  issue_detail      String?
  status            warranty_claim_status   @default(SUBMITTED)
  priority          warranty_claim_priority @default(NORMAL)
  due_at            DateTime?
  sla_breached_at   DateTime?
  metadata          Json?
  submitted_at      DateTime                @default(now())
  resolved_at       DateTime?
  created_at        DateTime                @default(now())
  updated_at        DateTime                @updatedAt

  warranty               Warranty                            @relation(fields: [warranty_id], references: [id], onDelete: Cascade)
  product                Product                             @relation(fields: [product_id], references: [id], onDelete: Cascade)
  customer               Customer?                           @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  service_center         ServiceCenter?                      @relation(fields: [service_center_id], references: [id], onDelete: SetNull)
  status_history         WarrantyClaimStatusHistory[]
  service_center_history WarrantyClaimServiceCenterHistory[]

  @@index([claim_code])
  @@index([warranty_code])
  @@index([status])
  @@index([product_id])
  @@index([customer_id])
  @@index([service_center_id])
  @@index([priority])
  @@index([due_at])
  @@index([sla_breached_at])
  @@index([created_at])
  @@map("warranty_claim")
}

model WarrantyClaimStatusHistory {
  id                 String                 @id @default(uuid()) @db.Uuid
  warranty_claim_id  String                 @db.Uuid
  from_status        warranty_claim_status?
  to_status          warranty_claim_status
  note               String?
  changed_by_user_id String?                @db.Uuid
  created_at         DateTime               @default(now())

  warranty_claim WarrantyClaim @relation(fields: [warranty_claim_id], references: [id], onDelete: Cascade)
  changed_by     User?         @relation("WarrantyClaimStatusChangedBy", fields: [changed_by_user_id], references: [id], onDelete: SetNull)

  @@index([warranty_claim_id, created_at])
  @@index([to_status])
  @@index([changed_by_user_id])
  @@map("warranty_claim_status_history")
}

model WarrantyClaimServiceCenterHistory {
  id                       String   @id @default(uuid()) @db.Uuid
  warranty_claim_id        String   @db.Uuid
  from_service_center_id   String?  @db.Uuid
  from_service_center_name String?
  to_service_center_id     String   @db.Uuid
  to_service_center_name   String
  note                     String?
  changed_by_user_id       String?  @db.Uuid
  created_at               DateTime @default(now())

  warranty_claim      WarrantyClaim  @relation(fields: [warranty_claim_id], references: [id], onDelete: Cascade)
  from_service_center ServiceCenter? @relation("WarrantyClaimServiceCenterFrom", fields: [from_service_center_id], references: [id], onDelete: SetNull, map: "warranty_claim_service_center_history_from_service_center_id_fk")
  to_service_center   ServiceCenter  @relation("WarrantyClaimServiceCenterTo", fields: [to_service_center_id], references: [id], onDelete: Restrict)
  changed_by          User?          @relation("WarrantyClaimServiceCenterChangedBy", fields: [changed_by_user_id], references: [id], onDelete: SetNull)

  @@index([warranty_claim_id, created_at], map: "warranty_claim_service_center_history_warranty_claim_id_created")
  @@index([from_service_center_id], map: "warranty_claim_service_center_history_from_service_center_id_id")
  @@index([to_service_center_id])
  @@index([changed_by_user_id])
  @@map("warranty_claim_service_center_history")
}

model ServiceCenter {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  phone      String?  @unique
  email      String?  @unique
  province   String
  district   String?
  address    String
  is_active  Boolean  @default(true)
  metadata   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  claims                 WarrantyClaim[]
  claim_assignments_from WarrantyClaimServiceCenterHistory[] @relation("WarrantyClaimServiceCenterFrom")
  claim_assignments_to   WarrantyClaimServiceCenterHistory[] @relation("WarrantyClaimServiceCenterTo")

  @@index([is_active])
  @@index([province])
  @@index([name])
  @@map("service_center")
}

enum user_role {
  ADMIN
  MODERATOR
  CUSTOMER
}

enum user_status {
  ACTIVE
  INACTIVE
}

enum asset_type {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
  THUMBNAIL
  BANNER
}

enum asset_access_type {
  PUBLIC
  PRIVATE
  TEMP
}

enum notification_source {
  ADMIN
  SYSTEM
}

enum notification_scope {
  ALL
  ROLE
  USER
}

enum notification_delivery_status {
  SCHEDULED
  SENT
}

enum notification_read_status {
  UNREAD
  READ
}

enum permission_key {
  DASHBOARD_VIEW

  CUSTOMER_VIEW
  CUSTOMER_CREATE
  CUSTOMER_UPDATE
  CUSTOMER_DELETE

  PRODUCT_VIEW
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_DELETE
  PRODUCT_ASSIGN_OWNER

  WARRANTY_VIEW
  WARRANTY_CREATE
  WARRANTY_UPDATE
  WARRANTY_ACTIVATE
  WARRANTY_VOID
  WARRANTY_LOOKUP_OWN

  WARRANTY_CLAIM_VIEW
  WARRANTY_CLAIM_CREATE
  WARRANTY_CLAIM_UPDATE
  WARRANTY_CLAIM_STATUS_UPDATE

  SERVICE_CENTER_VIEW
  SERVICE_CENTER_CREATE
  SERVICE_CENTER_UPDATE
  SERVICE_CENTER_DELETE

  DEALER_VIEW
  DEALER_CREATE
  DEALER_UPDATE
  DEALER_DELETE

  CONTENT_PAGE_VIEW
  CONTENT_PAGE_CREATE
  CONTENT_PAGE_UPDATE
  CONTENT_PAGE_DELETE

  CATEGORY_VIEW
  CATEGORY_CREATE
  CATEGORY_UPDATE
  CATEGORY_DELETE

  USER_VIEW
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  USER_PERMISSION_MANAGE

  SYSTEM_VIEW
  AUDIT_LOG_VIEW
}

enum product_category {
  CAR
  ACCESSORY
  SPARE_PART
  SERVICE_PACKAGE
}

enum category_type {
  PRODUCT
  CONTENT_PAGE
  ASSET
  WARRANTY_CLAIM_ISSUE
}

enum product_status {
  ACTIVE
  INACTIVE
  DELETED
}

enum product_asset_role {
  COVER
  GALLERY
  SERIAL
  INSTALLATION
}

enum warranty_status {
  DRAFT
  ACTIVE
  EXPIRED
  VOIDED
}

enum warranty_activation_request_status {
  PENDING
  APPROVED
  REJECTED
  ACTIVATED
  CANCELLED
}

enum warranty_activation_request_source {
  PUBLIC_WEB
  ADMIN_PORTAL
}

enum warranty_certificate_status {
  PENDING
  GENERATED
  FAILED
}

enum warranty_certificate_email_status {
  PENDING
  QUEUED
  SENT
  FAILED
}

enum warranty_claim_status {
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED
  IN_REPAIR
  COMPLETED
  CANCELLED
}

enum warranty_claim_priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum content_page_kind {
  POLICY
  GUIDE
  INTRO
  FAQ
}

enum content_page_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}
