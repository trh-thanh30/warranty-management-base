generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                  @id @default(uuid()) @db.Uuid
  email             String                  @unique
  password          String
  username          String                  @unique
  full_name         String?
  phone             String?                 @unique
  avatar_url        String?
  role              user_role               @default(CUSTOMER)
  status            user_status             @default(ACTIVE)
  is_verified       Boolean                 @default(false)
  two_factor_method admin_two_factor_method @default(EMAIL_OTP)
  pin_hash          String?
  refresh_token     String?
  created_at        DateTime                @default(now())
  updated_at        DateTime                @updatedAt

  assets                                Asset[]
  created_notifications                 Notification[]                      @relation("NotificationCreatedBy")
  notification_recipients               NotificationRecipient[]
  permissions                           UserPermission[]
  customer_profile                      Customer?
  owned_products                        ProductOwnership[]
  warranty_claim_changes                WarrantyClaimStatusHistory[]        @relation("WarrantyClaimStatusChangedBy")
  warranty_claim_service_center_changes WarrantyClaimServiceCenterHistory[] @relation("WarrantyClaimServiceCenterChangedBy")
  reviewed_warranty_activation_requests WarrantyActivationRequest[]         @relation("WarrantyActivationRequestReviewedBy")
  created_warranty_activation_requests  WarrantyActivationRequest[]         @relation("WarrantyActivationRequestCreatedBy")
  activated_warranties                  Warranty[]                          @relation("WarrantyActivatedBy")
  voided_warranties                     Warranty[]                          @relation("WarrantyVoidedBy")
  published_website_site_revisions      WebsiteSiteRevision[]               @relation("WebsiteSitePublishedBy")
  website_config_audits                 WebsiteConfigAudit[]
  activation_code_batches               ActivationCodeBatch[]               @relation("ActivationCodeBatchCreatedBy")
  activation_code_print_jobs            ActivationCodePrintJob[]            @relation("ActivationCodePrintJobRequestedBy")
  updated_system_configs                SystemConfig[]                      @relation("SystemConfigUpdatedBy")
  dealer_memberships                    DealerMembership[]                  @relation("DealerMembershipUser")
  created_dealer_memberships            DealerMembership[]                  @relation("DealerMembershipCreatedBy")

  @@index([role, status])
  @@index([email])
  @@map("user")
}

model Asset {
  id             String            @id @default(uuid()) @db.Uuid
  original_name  String
  filename       String
  mime_type      String
  size           Int
  path           String
  access_type    asset_access_type @default(PUBLIC)
  type           asset_type        @default(OTHER)
  folder         String?
  metadata       Json?
  is_deleted     Boolean           @default(false)
  uploaded_by_id String?           @db.Uuid
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  uploaded_by                 User?                 @relation(fields: [uploaded_by_id], references: [id])
  links                       AssetLink[]
  product_assets              ProductAsset[]
  website_site_header_logos   WebsiteSiteRevision[] @relation("WebsiteSiteHeaderLogo")
  website_site_footer_logos   WebsiteSiteRevision[] @relation("WebsiteSiteFooterLogo")
  website_site_og_images      WebsiteSiteRevision[] @relation("WebsiteSiteOgImage")
  website_hero_desktop_images WebsiteHeroSlide[]    @relation("WebsiteHeroDesktopImage")
  website_hero_mobile_images  WebsiteHeroSlide[]    @relation("WebsiteHeroMobileImage")

  @@index([access_type])
  @@index([type])
  @@index([uploaded_by_id])
  @@index([is_deleted])
  @@index([created_at])
  @@map("asset")
}

model AssetLink {
  id          String   @id @default(uuid()) @db.Uuid
  asset_id    String   @db.Uuid
  entity_id   String   @db.Uuid
  entity_type String
  created_at  DateTime @default(now())

  asset Asset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@unique([asset_id, entity_id, entity_type])
  @@index([entity_id, entity_type])
  @@map("asset_link")
}

model Notification {
  id              String                       @id @default(uuid()) @db.Uuid
  title           String
  content         String
  type            String
  source          notification_source          @default(SYSTEM)
  scope           notification_scope
  delivery_status notification_delivery_status @default(SENT)
  metadata        Json?
  scheduled_at    DateTime?
  sent_at         DateTime?
  created_by_id   String?                      @db.Uuid
  created_at      DateTime                     @default(now())
  updated_at      DateTime                     @updatedAt

  created_by User?                   @relation("NotificationCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  recipients NotificationRecipient[]

  @@index([type])
  @@index([source])
  @@index([scope])
  @@index([delivery_status, scheduled_at])
  @@index([created_at])
  @@map("notification")
}

model NotificationRecipient {
  id              String                   @id @default(uuid()) @db.Uuid
  notification_id String                   @db.Uuid
  user_id         String                   @db.Uuid
  status          notification_read_status @default(UNREAD)
  read_at         DateTime?
  delivered_at    DateTime                 @default(now())
  created_at      DateTime                 @default(now())

  notification Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([notification_id, user_id])
  @@index([user_id, status, created_at])
  @@index([notification_id])
  @@map("notification_recipient")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  admin_id   String?  @db.Uuid
  admin_name String
  action     String
  type       String
  created_at DateTime @default(now())

  @@index([created_at])
  @@map("activity_log")
}

model ContactSubmission {
  id                 String                    @id @default(uuid()) @db.Uuid
  full_name          String
  phone              String
  content            String
  consultation_topic String?
  province_code      String?
  province_name      String?
  status             contact_submission_status @default(NEW)
  source_path        String?
  created_at         DateTime                  @default(now())
  updated_at         DateTime                  @updatedAt

  @@index([phone, status, created_at])
  @@index([status, created_at])
  @@index([created_at])
  @@map("contact_submissions")
}

model WebsiteSiteRevision {
  id                   String                 @id @default(uuid()) @db.Uuid
  site_key             String                 @default("main")
  state                website_revision_state @default(DRAFT)
  revision_number      Int                    @default(1)
  lock_version         Int                    @default(1)
  contact_email        String                 @default("")
  website_url          String                 @default("")
  header_logo_asset_id String?                @db.Uuid
  footer_logo_asset_id String?                @db.Uuid
  og_image_asset_id    String?                @db.Uuid
  published_at         DateTime?
  published_by_id      String?                @db.Uuid
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt

  header_logo  Asset? @relation("WebsiteSiteHeaderLogo", fields: [header_logo_asset_id], references: [id], onDelete: Restrict)
  footer_logo  Asset? @relation("WebsiteSiteFooterLogo", fields: [footer_logo_asset_id], references: [id], onDelete: Restrict)
  og_image     Asset? @relation("WebsiteSiteOgImage", fields: [og_image_asset_id], references: [id], onDelete: Restrict)
  published_by User?  @relation("WebsiteSitePublishedBy", fields: [published_by_id], references: [id], onDelete: SetNull)

  offices      WebsiteOffice[]
  social_links WebsiteSocialLink[]
  hero_slides  WebsiteHeroSlide[]

  @@index([site_key, state])
  @@index([site_key, revision_number])
  @@map("website_site_revision")
}

model WebsiteHeroSlide {
  id               String   @id @default(uuid()) @db.Uuid
  revision_id      String   @db.Uuid
  key              String
  desktop_asset_id String?  @db.Uuid
  mobile_asset_id  String?  @db.Uuid
  is_active        Boolean  @default(true)
  sort_order       Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  revision      WebsiteSiteRevision @relation(fields: [revision_id], references: [id], onDelete: Cascade)
  desktop_image Asset?              @relation("WebsiteHeroDesktopImage", fields: [desktop_asset_id], references: [id], onDelete: Restrict)
  mobile_image  Asset?              @relation("WebsiteHeroMobileImage", fields: [mobile_asset_id], references: [id], onDelete: Restrict)

  @@unique([revision_id, key])
  @@index([revision_id, is_active, sort_order])
  @@index([desktop_asset_id])
  @@index([mobile_asset_id])
  @@map("website_hero_slide")
}

model WebsiteOffice {
  id              String   @id @default(uuid()) @db.Uuid
  revision_id     String   @db.Uuid
  phone           String?
  is_active       Boolean  @default(true)
  is_headquarters Boolean  @default(false)
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  revision     WebsiteSiteRevision        @relation(fields: [revision_id], references: [id], onDelete: Cascade)
  translations WebsiteOfficeTranslation[]

  @@index([revision_id, is_active, sort_order])
  @@map("website_office")
}

model WebsiteOfficeTranslation {
  id        String         @id @default(uuid()) @db.Uuid
  office_id String         @db.Uuid
  locale    website_locale
  label     String         @default("")
  address   String         @default("")

  office WebsiteOffice @relation(fields: [office_id], references: [id], onDelete: Cascade)

  @@unique([office_id, locale])
  @@map("website_office_translation")
}

model WebsiteSocialLink {
  id          String                  @id @default(uuid()) @db.Uuid
  revision_id String                  @db.Uuid
  platform    website_social_platform
  label       String
  url         String
  is_active   Boolean                 @default(true)
  sort_order  Int                     @default(0)
  created_at  DateTime                @default(now())
  updated_at  DateTime                @updatedAt

  revision WebsiteSiteRevision @relation(fields: [revision_id], references: [id], onDelete: Cascade)

  @@index([revision_id, is_active, sort_order])
  @@map("website_social_link")
}

model WebsiteConfigAudit {
  id             String                      @id @default(uuid()) @db.Uuid
  actor_id       String?                     @db.Uuid
  domain         website_config_domain
  entity_id      String?
  site_key       String                      @default("main")
  action         website_config_audit_action
  before_version Int?
  after_version  Int?
  change_summary Json?
  created_at     DateTime                    @default(now())

  actor User? @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([domain, site_key, created_at])
  @@index([actor_id])
  @@map("website_config_audit")
}

model ContentPage {
  id           String              @id @default(uuid()) @db.Uuid
  category_id  String?             @db.Uuid
  slug         String              @unique
  title        String
  summary      String?
  content      String
  kind         content_page_kind   @default(GENERAL_POLICY)
  status       content_page_status @default(DRAFT)
  published_at DateTime?
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt

  category  Category?            @relation(fields: [category_id], references: [id], onDelete: SetNull)
  faq_items ContentPageFaqItem[]

  @@index([category_id])
  @@index([kind])
  @@index([status])
  @@index([published_at])
  @@map("content_page")
}

model ContentPageFaqItem {
  id              String   @id @default(uuid()) @db.Uuid
  content_page_id String   @db.Uuid
  question        String
  answer          String
  sort_order      Int      @default(0)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  content_page ContentPage @relation(fields: [content_page_id], references: [id], onDelete: Cascade)

  @@index([content_page_id, is_active, sort_order])
  @@map("content_page_faq_item")
}

model UserPermission {
  id             String         @id @default(uuid()) @db.Uuid
  user_id        String         @db.Uuid
  permission_key permission_key
  granted        Boolean        @default(true)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, permission_key])
  @@index([user_id])
  @@map("user_permission")
}

model Customer {
  id            String    @id @default(uuid()) @db.Uuid
  user_id       String?   @unique @db.Uuid
  customer_code String    @unique
  full_name     String
  phone         String?   @unique
  email         String?
  address       String?
  birthdate     DateTime?
  metadata      Json?
  deleted_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  user                         User?                       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  ownerships                   ProductOwnership[]
  claims                       WarrantyClaim[]
  warranty_activation_requests WarrantyActivationRequest[]

  @@index([customer_code])
  @@index([full_name])
  @@index([phone])
  @@index([email])
  @@index([deleted_at])
  @@map("customer")
}

model Category {
  id                      String        @id @default(uuid()) @db.Uuid
  type                    category_type
  code                    String?
  slug                    String
  name                    String
  description             String?
  parent_id               String?       @db.Uuid
  icon                    String?
  image_url               String?
  order                   Int           @default(0)
  is_active               Boolean       @default(true)
  activation_form_enabled Boolean       @default(false)
  activation_code_enabled Boolean       @default(true)
  metadata                Json?
  created_at              DateTime      @default(now())
  updated_at              DateTime      @updatedAt

  parent                       Category?                   @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children                     Category[]                  @relation("CategoryHierarchy")
  products                     Product[]
  content_pages                ContentPage[]
  warranty_activation_requests WarrantyActivationRequest[]
  activation_fields            CategoryActivationField[]

  @@unique([type, slug])
  @@index([type, is_active, order])
  @@index([parent_id])
  @@map("category")
}

model CategoryActivationField {
  id          String                         @id @default(uuid()) @db.Uuid
  category_id String                         @db.Uuid
  key         String
  label       String
  type        category_activation_field_type
  placeholder String?
  required    Boolean                        @default(false)
  sort_order  Int                            @default(0)
  is_active   Boolean                        @default(true)
  created_at  DateTime                       @default(now())
  updated_at  DateTime                       @updatedAt

  category      Category                        @relation(fields: [category_id], references: [id], onDelete: Cascade)
  options       CategoryActivationFieldOption[]
  request_items WarrantyActivationRequestItem[]

  @@unique([category_id, key])
  @@index([category_id, is_active, sort_order])
  @@map("category_activation_field")
}

model CategoryActivationFieldOption {
  id         String   @id @default(uuid()) @db.Uuid
  field_id   String   @db.Uuid
  label      String
  value      String
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  field CategoryActivationField @relation(fields: [field_id], references: [id], onDelete: Cascade)

  @@unique([field_id, value])
  @@index([field_id, sort_order])
  @@map("category_activation_field_option")
}

model Product {
  id                       String           @id @default(uuid()) @db.Uuid
  category_id              String           @db.Uuid
  current_warranty_id      String?          @unique @db.Uuid
  product_code             String           @unique
  serial_number            String?          @unique
  display_name             String?
  // Product-owned catalogue fields.
  slug                     String           @unique
  brand                    String?
  model                    String?
  model_year               Int?
  description              String?
  is_published             Boolean          @default(false)
  published_at             DateTime?
  status                   product_status   @default(ACTIVE)
  metadata                 Json?
  warranty_duration_months Int?
  warranty_method          warranty_method?
  warranty_terms           String?
  created_at               DateTime         @default(now())
  updated_at               DateTime         @updatedAt
  deleted_at               DateTime?

  category_ref                      Category                        @relation(fields: [category_id], references: [id], onDelete: Restrict)
  ownerships                        ProductOwnership[]
  // Transitional pointer for legacy flows. New issuance uses warranties[].
  warranty                          Warranty?                       @relation("ProductCurrentWarranty", fields: [current_warranty_id], references: [id], onDelete: SetNull)
  warranties                        Warranty[]                      @relation("ProductWarrantyHistory")
  claims                            WarrantyClaim[]
  assets                            ProductAsset[]
  warranty_activation_requests      WarrantyActivationRequest[]
  warranty_activation_request_items WarrantyActivationRequestItem[]
  activation_code_batch_sources     ActivationCodeBatch[]           @relation("ActivationCodeBatchSourceProduct")
  activation_code                   ActivationCode?                 @relation("ActivationCodeProduct")

  @@index([category_id])
  @@index([status])
  @@index([serial_number])
  @@index([display_name])
  @@map("product")
}

model ProductAsset {
  id         String             @id @default(uuid()) @db.Uuid
  product_id String             @db.Uuid
  asset_id   String             @db.Uuid
  role       product_asset_role @default(GALLERY)
  sort_order Int                @default(0)
  alt_text   String?
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@unique([product_id, asset_id])
  @@index([product_id, role, sort_order])
  @@index([asset_id])
  @@map("product_asset")
}

model ProductOwnership {
  id               String    @id @default(uuid()) @db.Uuid
  product_id       String    @db.Uuid
  customer_id      String    @db.Uuid
  owner_user_id    String?   @db.Uuid
  purchase_date    DateTime?
  activated_at     DateTime?
  ended_at         DateTime?
  is_current_owner Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  owner_user User?    @relation(fields: [owner_user_id], references: [id], onDelete: SetNull)

  @@index([product_id, is_current_owner])
  @@index([customer_id, is_current_owner])
  @@index([owner_user_id, is_current_owner])
  @@map("product_ownership")
}

model Warranty {
  id                    String          @id @default(uuid()) @db.Uuid
  product_id            String          @db.Uuid
  activation_code_id    String?         @unique @db.Uuid
  warranty_code         String?         @unique
  start_date            DateTime?
  end_date              DateTime?
  duration_months       Int
  coverage_limit_amount Decimal?        @db.Decimal(18, 2)
  max_claim_count       Int?
  max_amount_per_claim  Decimal?        @db.Decimal(18, 2)
  status                warranty_status @default(DRAFT)
  method                warranty_method @default(REPAIR)
  terms                 String?
  metadata              Json?
  activated_by_id       String?         @db.Uuid
  voided_at             DateTime?
  voided_by_id          String?         @db.Uuid
  void_reason           String?
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  product                  Product                         @relation("ProductWarrantyHistory", fields: [product_id], references: [id], onDelete: Cascade)
  current_for_product      Product?                        @relation("ProductCurrentWarranty")
  activation_code          ActivationCode?                 @relation("ActivationCodeWarranty", fields: [activation_code_id], references: [id], onDelete: SetNull)
  claims                   WarrantyClaim[]
  activation_request       WarrantyActivationRequest?
  activation_request_items WarrantyActivationRequestItem[]
  certificates             WarrantyCertificate[]
  activated_by             User?                           @relation("WarrantyActivatedBy", fields: [activated_by_id], references: [id], onDelete: SetNull)
  voided_by                User?                           @relation("WarrantyVoidedBy", fields: [voided_by_id], references: [id], onDelete: SetNull)

  @@index([warranty_code])
  @@index([product_id])
  @@index([status])
  @@index([end_date])
  @@index([activated_by_id])
  @@index([voided_by_id])
  @@index([voided_at])
  @@map("warranty")
}

model ActivationCodeBatch {
  id                       String           @id @default(uuid()) @db.Uuid
  batch_code               String           @unique
  batch_name               String
  source_product_id        String?          @db.Uuid
  product_sku              String?
  product_name             String?
  brand                    String?
  model                    String?
  model_year               Int?
  warranty_duration_months Int?
  warranty_method          warranty_method?
  warranty_terms           String?
  quantity                 Int
  expires_at               DateTime
  created_by_id            String           @db.Uuid
  created_at               DateTime         @default(now())
  updated_at               DateTime         @updatedAt

  source_product Product?                 @relation("ActivationCodeBatchSourceProduct", fields: [source_product_id], references: [id], onDelete: SetNull)
  created_by     User                     @relation("ActivationCodeBatchCreatedBy", fields: [created_by_id], references: [id], onDelete: Restrict)
  codes          ActivationCode[]
  print_jobs     ActivationCodePrintJob[]

  @@index([source_product_id])
  @@index([expires_at])
  @@index([created_at])
  @@map("activation_code_batch")
}

model ActivationCodePrintJob {
  id               String                           @id @default(uuid()) @db.Uuid
  batch_id         String                           @db.Uuid
  requested_by_id  String                           @db.Uuid
  idempotency_key  String                           @unique
  status           activation_code_print_job_status @default(QUEUED)
  progress_percent Int                              @default(0)
  from_index       Int
  to_index         Int
  label_width_mm   Float                            @default(45.7)
  label_height_mm  Float                            @default(16.9)
  bull_job_id      String?                          @unique
  storage_key      String?
  filename         String?
  error_message    String?
  attempts         Int                              @default(0)
  started_at       DateTime?
  completed_at     DateTime?
  created_at       DateTime                         @default(now())
  updated_at       DateTime                         @updatedAt

  batch        ActivationCodeBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  requested_by User                @relation("ActivationCodePrintJobRequestedBy", fields: [requested_by_id], references: [id], onDelete: Restrict)

  @@index([batch_id, created_at])
  @@index([status, created_at])
  @@map("activation_code_print_job")
}

model ActivationCode {
  id              String                 @id @default(uuid()) @db.Uuid
  batch_id        String                 @db.Uuid
  code_hash       String                 @unique
  code_ciphertext String
  status          activation_code_status @default(AVAILABLE)
  expires_at      DateTime
  product_id      String?                @unique @db.Uuid
  activated_at    DateTime?
  revoked_at      DateTime?
  replaced_by_id  String?                @unique @db.Uuid
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt

  batch         ActivationCodeBatch             @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  request       WarrantyActivationRequest?      @relation("ActivationCodeRequest")
  request_items WarrantyActivationRequestItem[] @relation("ActivationCodeRequestItem")
  product       Product?                        @relation("ActivationCodeProduct", fields: [product_id], references: [id], onDelete: SetNull)
  warranty      Warranty?                       @relation("ActivationCodeWarranty")
  replaced_by   ActivationCode?                 @relation("ActivationCodeReplacement", fields: [replaced_by_id], references: [id], onDelete: SetNull)
  replaces      ActivationCode?                 @relation("ActivationCodeReplacement")

  @@index([batch_id, status])
  @@index([status, expires_at])
  @@index([status, created_at])
  @@index([created_at])
  @@map("activation_code")
}

model WarrantyActivationRequest {
  id                       String                             @id @default(uuid()) @db.Uuid
  request_code             String                             @unique
  status                   warranty_activation_request_status @default(PENDING)
  source                   warranty_activation_request_source @default(PUBLIC_WEB)
  warranty_code            String
  customer_name            String
  customer_phone           String
  customer_email           String?
  customer_birthdate       DateTime?
  category_id              String?                            @db.Uuid
  product_id               String?                            @db.Uuid
  dealer_id                String?                            @db.Uuid
  vehicle_plate            String?
  vehicle_model            String?
  installed_at             DateTime?
  warranty_duration_months Int?
  province_code            String
  province_name            String
  ward_code                String
  ward_name                String
  address_detail           String
  full_address             String
  product_name             String?
  serial_number            String?
  brand                    String?
  model                    String?
  manufacture_year         Int?
  note                     String?
  admin_note               String?
  rejection_reason         String?
  created_by_id            String?                            @db.Uuid
  customer_id              String?                            @db.Uuid
  reviewed_by_id           String?                            @db.Uuid
  reviewed_at              DateTime?
  activated_warranty_id    String?                            @unique @db.Uuid
  activation_code_id       String?                            @unique @db.Uuid
  metadata                 Json?
  created_at               DateTime                           @default(now())
  updated_at               DateTime                           @updatedAt

  created_by         User?                                 @relation("WarrantyActivationRequestCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  customer           Customer?                             @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  category           Category?                             @relation(fields: [category_id], references: [id], onDelete: SetNull)
  product            Product?                              @relation(fields: [product_id], references: [id], onDelete: SetNull)
  dealer             Dealer?                               @relation(fields: [dealer_id], references: [id], onDelete: SetNull)
  reviewed_by        User?                                 @relation("WarrantyActivationRequestReviewedBy", fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  activated_warranty Warranty?                             @relation(fields: [activated_warranty_id], references: [id], onDelete: SetNull)
  activation_code    ActivationCode?                       @relation("ActivationCodeRequest", fields: [activation_code_id], references: [id], onDelete: SetNull)
  items              WarrantyActivationRequestItem[]
  certificate        WarrantyActivationRequestCertificate?

  @@index([request_code])
  @@index([status])
  @@index([source])
  @@index([warranty_code])
  @@index([customer_phone])
  @@index([customer_email])
  @@index([category_id])
  @@index([product_id])
  @@index([dealer_id])
  @@index([vehicle_plate])
  @@index([created_by_id])
  @@index([customer_id])
  @@index([province_code])
  @@index([created_at])
  @@index([warranty_code, customer_phone, status], map: "warranty_activation_request_lookup_pending")
  @@map("warranty_activation_request")
}

model WarrantyActivationRequestItem {
  id                  String                             @id @default(uuid()) @db.Uuid
  request_id          String                             @db.Uuid
  activation_field_id String?                            @db.Uuid
  position_key        String
  position_label      String
  product_id          String                             @db.Uuid
  activation_code_id  String?                            @db.Uuid
  warranty_id         String?                            @db.Uuid
  warranty_code       String?                            @unique
  product_name        String
  product_code        String
  serial_number       String?
  status              warranty_activation_request_status @default(PENDING)
  activated_at        DateTime?
  created_at          DateTime                           @default(now())
  updated_at          DateTime                           @updatedAt

  request          WarrantyActivationRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  activation_field CategoryActivationField?  @relation(fields: [activation_field_id], references: [id], onDelete: SetNull)
  product          Product                   @relation(fields: [product_id], references: [id], onDelete: Restrict)
  activation_code  ActivationCode?           @relation("ActivationCodeRequestItem", fields: [activation_code_id], references: [id], onDelete: SetNull)
  warranty         Warranty?                 @relation(fields: [warranty_id], references: [id], onDelete: Restrict)

  @@unique([request_id, position_key])
  @@index([request_id, status])
  @@index([activation_code_id, status])
  @@index([product_id, status])
  @@index([warranty_id])
  @@map("warranty_activation_request_item")
}

model WarrantyCertificate {
  id                 String                            @id @default(uuid()) @db.Uuid
  warranty_id        String                            @db.Uuid
  certificate_number String                            @unique
  version            Int                               @default(1)
  status             warranty_certificate_status       @default(PENDING)
  storage_key        String?
  recipient_email    String?
  generated_at       DateTime?
  emailed_at         DateTime?
  email_status       warranty_certificate_email_status @default(PENDING)
  last_error         String?
  metadata           Json?
  created_at         DateTime                          @default(now())
  updated_at         DateTime                          @updatedAt

  warranty Warranty @relation(fields: [warranty_id], references: [id], onDelete: Cascade)

  @@index([warranty_id])
  @@index([certificate_number])
  @@index([status])
  @@index([email_status])
  @@index([recipient_email])
  @@map("warranty_certificate")
}

model WarrantyActivationRequestCertificate {
  id                    String                            @id @default(uuid()) @db.Uuid
  activation_request_id String                            @unique(map: "warranty_activation_request_certificate_activation_request_id_k") @db.Uuid
  certificate_number    String                            @unique
  version               Int                               @default(1)
  status                warranty_certificate_status       @default(PENDING)
  storage_key           String?
  recipient_email       String?
  generated_at          DateTime?
  emailed_at            DateTime?
  email_status          warranty_certificate_email_status @default(PENDING)
  last_error            String?
  metadata              Json?
  created_at            DateTime                          @default(now())
  updated_at            DateTime                          @updatedAt

  activation_request WarrantyActivationRequest @relation(fields: [activation_request_id], references: [id], onDelete: Cascade, map: "warranty_activation_request_certificate_activation_request_id_f")

  @@index([certificate_number])
  @@index([status])
  @@index([email_status])
  @@index([recipient_email])
  @@map("warranty_activation_request_certificate")
}

model Dealer {
